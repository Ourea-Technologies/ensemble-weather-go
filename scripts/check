#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
#
# Run every gate CI runs, in order, stopping at the first failure:
# format, vet, staticcheck, golangci-lint (incl. revive and gosec),
# govulncheck, the dependency check, unit tests + vectors + examples (race
# detector on), the spec-drift module, the docs render and the build.
#
#   scripts/check            all gates
#   SKIP_VULN=1 scripts/check  skip govulncheck (it needs the network)
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

# Tool versions, kept in step with .github/workflows.
GOLANGCI_LINT=github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0
STATICCHECK=honnef.co/go/tools/cmd/staticcheck@v0.8.2
GOVULNCHECK=golang.org/x/vuln/cmd/govulncheck@v1.9.0

step() { printf '\n== %s\n' "$*"; }

step gofmt
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "not gofmt-formatted:" >&2
	echo "$unformatted" >&2
	exit 1
fi

step go vet
go vet ./...
(cd spectest && go vet ./...)

step staticcheck
go run "$STATICCHECK" -checks all ./...
(cd spectest && go run "$STATICCHECK" -checks all ./...)

step golangci-lint
go run "$GOLANGCI_LINT" run ./...
(cd spectest && go run "$GOLANGCI_LINT" run --config ../.golangci.yml ./...)

if [ "${SKIP_VULN:-}" != 1 ]; then
	step govulncheck
	go run "$GOVULNCHECK" ./...
fi

step dependencies
scripts/check-deps

step tests, vectors and examples
go test -race -count=1 -coverprofile=coverage.out ./...
go tool cover -func=coverage.out | tail -1

step spec drift
(cd spectest && go test -count=1 ./...)

step docs
go doc -all . >/dev/null

step build
go build ./...

printf '\nall gates passed\n'
